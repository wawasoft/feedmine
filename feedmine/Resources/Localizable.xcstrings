    "This category has articles in the feed, but they may have been trimmed from the visible buffer. Try scrolling through All first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This category has articles in the feed, but they may have been trimmed from the visible buffer. Try scrolling through All first."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الفئة لديها مقالات، لكنها قد تكون اقتطعت. جرب التمرير عبر الكل أولاً."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta categoría tiene artículos, pero pueden haber sido recortados. Intenta ver Todo primero."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato kategorie má články, ale mohly být oříznuty. Zkuste nejdřív Vše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kategori har artikler i feedet, men de kan være blevet beskåret fra den synlige buffer. Prøv at scrolle gennem Alle først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kategorie hat Artikel, aber sie wurden möglicherweise gekürzt. Versuche zuerst Alle."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa categoria ha articoli, ma potrebbero essere stati tagliati. Prova a scorrere Tutto prima."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This category has articles in the feed, but they may have been trimmed from the visible buffer. Try scrolling through All first."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This category has articles in the feed, but they may have been trimmed from the visible buffer. Try scrolling through All first."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "This category has articles in the feed, but they may have been trimmed from the visible buffer. Try scrolling through All first."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta categoría tiene artículos, pero pueden haber sido recortados. Intenta ver Todo primero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta categoría tiene artículos, pero pueden haber sido recortados. Intenta ver Todo primero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä kategoriassa on artikkelia, mutta ne on saatettu rajata. Kokeile ensin Kaikki."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette catégorie a des articles, mais ils ont pu être coupés. Essayez de faire défiler Tout d'abord."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette catégorie a des articles, mais ils ont pu être coupés. Essayez de faire défiler Tout d'abord."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בקטגוריה זו יש מאמרים, אך ייתכן שהם קוצצו. נסה לגלול דרך הכל תחילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस श्रेणी में लेख हैं, लेकिन हो सकता है कि वे बफर से काट दिए गए हों। पहले सभी में स्क्रॉल करके देखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova kategorija ima članke, ali su možda izbačeni. Pokušajte prvo Sve."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebben a kategóriában cikk, de lehet lehettek megvágva. Próbáld először az Összeset."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "dalam artikel jadi adalah dari telah Semua dalam"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
