    "All %lld sources failed to load. Check your internet connection and pull to refresh.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All %lld sources failed to load. Check your internet connection and pull to refresh."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشلت جميع مصادر %lld. تحقق من اتصالك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las %lld fuentes fallaron. Verifica tu internet y desliza para actualizar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny %lld zdrojů selhaly při načítání. Zkontrolujte internet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %lld kilder kunne ikke indlæses. Tjek din internetforbindelse og træk for at opdatere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %lld Quellen konnten nicht geladen werden. Überprüfe deine Internetverbindung und ziehe zum Aktualisieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte οι %lld πηγές hanno fallito. Controlla η connessione."
          }
        },
        "en-AU": {
