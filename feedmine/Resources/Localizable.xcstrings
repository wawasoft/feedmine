            "state": "translated",
            "value": "semua baca esok"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt lest. Sov godt. Nyhetene er her igjen i morgen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles gelezen. Slaap lekker. Het nieuws is er morgen weer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko przeczytane. Śpij spokojnie. Wiadomości będą jutro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo em dia. Durma bem. As notícias estarão aqui amanhã."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo em dia. Durma bem. As notícias estarão aqui amanhã."
          }
        },
