          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תמחק את כל הסימניות, היסטוריית הקריאה והגדרות המקורות. לא ניתן לבטל פעולה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बुकमार्क, इतिहास और स्रोत कॉन्फ़िगरेशन हटाएगा। वापस नहीं ला सकते।"
