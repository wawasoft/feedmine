    "The world's still quiet. Stories are on their way.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The world's still quiet. Stories are on their way."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العالم ما زال هادئاً. القصص في الطريق."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El mundo aún está quieto. Las historias están en camino."
          }
        },
        "cs": {
