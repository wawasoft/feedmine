    "All caught up. Sleep well. The news will be here tomorrow.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All caught up. Sleep well. The news will be here tomorrow."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء مقروء. نم جيداً. الأخبار هنا غداً."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo al día. Duerme bien. Las noticias estarán aquí mañana."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše přečteno. Dobrou noc. Zprávy budou zítra."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt læst. Sov godt. Nyhederne er her igen i morgen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles gelesen. Schlaf gut. Die Nachrichten sind morgen wieder da."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto letto. Dormi bene. Le notizie saranno qui domani."
          }
        },
