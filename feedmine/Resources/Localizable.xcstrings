            "value": "सब पढ़ लिया। अच्छी नींद लें। कल खबरें आएंगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve pročitano. Laku noć. Vijesti će biti tu sutra."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden elolvasva. Aludj jól. A hírek holnap is itt lesznek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "semua baca besok"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto letto. Dormi bene. Le notizie saranno qui domani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全部読了。おやすみ。明日もニュースはある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 읽음. 잘 자요. 내일 뉴스가 올 거예요."
