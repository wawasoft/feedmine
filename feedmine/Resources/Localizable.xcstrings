    "Import an OPML file to add new sources, or export your current sources to share or back up.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import an OPML file to add new sources, or export your current sources to share or back up."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استورد OPML لإضافة مصادر، أو صدّر للمشاركة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa un archivo OPML para añadir nuevas fuentes, o exporta tus fuentes actuales para compartir o respaldar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Importujte OPML pro přidání zdrojů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer en OPML-fil for at tilføje nye kilder, eller eksporter dine nuværende kilder for at dele eller tage backup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere eine OPML-Datei, um neue Quellen hinzuzufügen, oder exportiere deine aktuellen Quellen zum Teilen oder Sichern."
          }
