+                                Text("• \(item.title)")
+                                    .font(.caption)
+                                    .foregroundStyle(.secondary)
+                                    .lineLimit(1)
+                            }
+                        }
+                        .padding(.leading, 28)
+                    } else {
+                        fallthrough
+                    }
+
+                case .empty:
