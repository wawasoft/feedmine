+                            .font(.caption)
+                            .foregroundStyle(.orange)
+                        Text("Already in Feedmine")
+                            .font(.caption)
+                            .foregroundStyle(.secondary)
+                    }
+                    .padding(.leading, 28)
+
+                case .error(let message):
+                    HStack(spacing: 4) {
+                        Image(systemName: "xmark.circle.fill")
+                            .font(.caption)
+                            .foregroundStyle(.red)
+                        Text(message)
+                            .font(.caption)
